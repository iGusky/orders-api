# Copia este archivo a .env y llena los valores. En producción se definen en Dokploy (ver docs/despliegue.md).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/orders
# Client ID de Google (el mismo que VITE_GOOGLE_CLIENT_ID en apps/web); se valida como `audience`.
OAUTH_CLIENT_ID=
# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGIN=http://localhost:4200
PORT=3000
