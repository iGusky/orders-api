model Store {
  id           String     @id @default(uuid(7)) @db.Uuid
  ownerId      String     @unique @db.Uuid
  owner        User       @relation(fields: [ownerId], references: [id])
  name         String
  address      String
  phone        String
  description  String?
  contactEmail String?
  createdAt    DateTime   @default(now())
  deletedAt    DateTime?
  movements    Movement[]
  products     Product[]
}
