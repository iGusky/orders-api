model User {
  id              String            @id @default(uuid(7)) @db.Uuid
  googleSub       String            @unique
  email           String
  name            String
  avatarUrl       String?
  createdAt       DateTime          @default(now())
  deletedAt       DateTime?
  store           Store?
  sessions        Session[]
  memberships     StoreMember[]     @relation("StoreMemberUser")
  addedMembers    StoreMember[]     @relation("StoreMemberAddedBy")
  sentInvitations StoreInvitation[]
  movements       Movement[]
}
