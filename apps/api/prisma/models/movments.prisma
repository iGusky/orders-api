model Movement {
  id String @id @db.Uuid @default(uuid(7))
  type MovementType
  direction MovementDirectionType?
  occurredAt DateTime
  createdAt DateTime @default(now())
  totalCents Int
  items MovementItem[]
}

enum MovementType {
  RESTOCK
  SALE
  RETURN
  SHRINKAGE
  ADJUSTMENT
}

enum MovementDirectionType {
  IN
  OUT
}

model MovementItem {
  id String @id @db.Uuid @default(uuid(7))
  movementId String @db.Uuid
  movement Movement @relation(fields: [movementId], references: [id])
  productId String @db.Uuid
  product Product @relation(fields: [productId], references: [id])
  quantity Int
  lineTotalCents Int
}